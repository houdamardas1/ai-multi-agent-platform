# Clé API Groq (lue par technologies/llm_engine.py sous le nom OPENAI_API_KEY : API compatible OpenAI)
OPENAI_API_KEY=
GROQ_API_KEY=

# Gmail : adresse et mot de passe d'application (IMAP / SMTP)
GMAIL_ADRESSE=
GMAIL_MOT_DE_PASSE=
# Destinataires des alertes, séparés par des virgules
RESPONSABLES=

# PostgreSQL
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=agents_ia_db
DATABASE_USER=agents_user
DATABASE_PASSWORD=

# Comptes de connexion à l'interface (aucun compte n'est actif sans mot de passe)
ADMIN_EMAIL=admin@agents-ia.com
ADMIN_PASSWORD=
CLIENT_EMAIL=client@test.com
CLIENT_PASSWORD=

# Datasets (Enron, CUAD, Customer Support, MultiWOZ) et index FAISS
ENRON_DATASET_PATH=./datasets/enron
CUAD_DATASET_PATH=./datasets/cuad
SUPPORT_DATASET_PATH=./datasets/customer_support
MULTIWOZ_DATASET_PATH=./datasets/multiwoz
VECTOR_STORE_PATH=./chroma_db

# Origines autorisées pour l'interface web
ALLOWED_ORIGINS=http://localhost:5173

# Automatisation
ENABLE_EMAIL_SURVEILLANCE=true
ENABLE_RULES_ENGINE=true
